# TruthLens AI - Environment Configuration
# Copy this file to ".env" and adjust values as needed for local development.

# Flask Secret Key for Session Security (generate a strong random value in production)
SECRET_KEY=replace-with-your-secret-key 

# JWT Authentication Secret (generate a strong random value in production)
JWT_SECRET_KEY=replace-with-your-jwt-secret 

# Database Connection (Defaults to SQLite for local development; PostgreSQL compatible)
# DATABASE_URL=postgresql://user:password@localhost:5432/truthlens_db
DATABASE_URL=sqlite:///instance/truthlens.db

# Server Port
PORT=5000

# Environment Mode (development or production)
FLASK_ENV=development
